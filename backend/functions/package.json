{
  "name": "functions",
  "version": "0.1.0",
  "files": [
    "lib",
    ".env"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "typecheck": "tsc -b && tsc -p test",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --format=github",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./trpc": {
      "types": "./src/trpc/routers/index.ts"
    }
  },
  "dependencies": {
    "@app-portal/shared": "workspace:*",
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/tasks": "^6.2.1",
    "@trpc/server": "^11.29.7",
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.0.2",
    "superjson": "^2.2.7",
    "uuid": "^11.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "vitest": "^5.1.1"
  },
  "private": true
}
