{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "ignoreDependencies": [
    // firebase deployment
    "isolate-package",
    "@google-cloud/functions-framework"
  ],
  "ignoreIssues": {
    // shadcn interfaces
    "frontend/src/components/ui/**": ["exports"]
  },
  "ignoreBinaries": [
    // typically globally installed
    "firebase"
  ],
  "workspaces": {
    ".": {}
  }
}
