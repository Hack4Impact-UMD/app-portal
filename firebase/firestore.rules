rules_version = '2';

// All reads and writes go through the tRPC backend, which uses the Admin SDK
// and bypasses these rules. The only client access left is the live
// grading-job subscriptions.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null && request.auth.token.email_verified && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApplicant() {
      return isAuthed() && getCurrentUser().data.role == "applicant";
    }

    function isReviewer() {
      return isAuthed() && (getCurrentUser().data.role in ["reviewer", "board", "super-reviewer"]);
    }

    function ownsResponse(responseId) {
      let responseDocPath = /databases/$(database)/documents/application-responses/$(responseId);
      return exists(responseDocPath) && request.auth.uid == get(responseDocPath).data.userId;
    }

    match /grading-jobs-public/{job_id} {
      allow read: if isReviewer() || (isApplicant() && ownsResponse(resource.data.responseId));
      allow write: if false;
    }

    match /grading-jobs-internal/{job_id} {
      allow read: if isReviewer();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
